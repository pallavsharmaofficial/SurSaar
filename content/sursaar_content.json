    {
      "id": "strumming_patterns",
      "title": "Strumming Patterns",
      "category": "Rhythm",
      "description": "Master the essential strumming patterns behind most popular songs.",
      "difficulty": "beginner",
      "kind": "strumming",
      "targetChords": [
        "G",
        "D"
      ],
      "targetStrumming": "D DU UDU",
      "targetBpm": 80,
      "steps": [
        {
          "title": "Down/up basics",
          "description": "Alternate down and up strokes at 80 BPM.",
          "durationMinutes": 6
        },
        {
          "title": "Pattern 1",
          "description": "D D U U D U for 4 minutes.",
          "durationMinutes": 6
        },
        {
          "title": "Pattern 2",
          "description": "D DU UDU with the accent on beat 2.",
          "durationMinutes": 6
        },
        {
          "title": "Muted strums",
          "description": "Add muted strokes for rhythm control.",
          "durationMinutes": 6
        },
        {
          "title": "Tempo build",
          "description": "Increase speed from 70 to 90 BPM.",
