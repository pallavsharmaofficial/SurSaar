  "lessons": [
    {
      "id": "open_chord_foundation",
      "title": "The Open Chord Foundation",
      "category": "Fundamentals",
      "description": "Learn to play the G major and C major open chords without buzzing strings.",
      "difficulty": "beginner",
      "kind": "chord",
      "targetChords": [
        "G",
        "C"
      ],
      "targetStrumming": "D D D D",
      "targetBpm": 60,
      "steps": [
        {
          "title": "Understanding chord anatomy",
          "description": "What makes up a chord and how fingers sit behind the fret.",
          "durationMinutes": 5
        },
        {
          "title": "G major",
          "description": "Middle finger 3rd fret low E, index 2nd fret A, ring 3rd fret high e.",
          "durationMinutes": 8
        },
        {
          "title": "C major",
          "description": "Ring 3rd fret A, middle 2nd fret D, index 1st fret B. Skip the low E.",
          "durationMinutes": 8
        },
        {
          "title": "Clean check",
          "description": "Pluck each string one at a time and fix any buzz.",
          "durationMinutes": 4
        }
      ],
      "instrument": "guitar",
      "topicsCount": 4,
      "duration": 25,
      "isCompleted": false,
      "progress": 0.0
    },
    {
