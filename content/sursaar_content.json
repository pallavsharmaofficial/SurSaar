    {
      "id": "chord_transitions",
      "title": "Smooth Chord Transitions",
      "category": "Technique",
      "description": "Improve your chord switching speed and accuracy.",
      "difficulty": "intermediate",
      "kind": "chord",
      "targetChords": [
        "G",
        "C",
        "D",
        "Em"
      ],
      "targetStrumming": "D DU UDU",
      "targetBpm": 80,
      "steps": [
        {
          "title": "Anchor fingers",
          "description": "Keep the ring finger planted between G and C.",
          "durationMinutes": 8
        },
        {
          "title": "Two-chord drill",
          "description": "Switch G ↔ Em for 2 minutes.",
          "durationMinutes": 6
        },
        {
          "title": "Three-chord drill",
          "description": "Cycle C → G → D at 80 BPM.",
          "durationMinutes": 8
        },
        {
          "title": "Clean transitions",
          "description": "Lift fingers just enough to remove buzzing.",
          "durationMinutes": 7
        },
        {
          "title": "Challenge",
          "description": "Play the 4 chords for 4 minutes at 90 BPM.",
          "durationMinutes": 6
        }
      ],
      "instrument": "guitar",
