        "A",
        "Bm"
      ],
      "targetStrumming": "D X DU X DU",
      "targetBpm": 85,
      "steps": [
        {
          "title": "Downstroke with the thumb",
          "description": "Relaxed wrist, strike all six strings.",
          "durationMinutes": 5
        },
        {
          "title": "Palm mute (X)",
          "description": "Land the side of the palm on the strings for a percussive slap.",
          "durationMinutes": 8
        },
        {
          "title": "Quick up-down",
          "description": "Light up-down on the higher strings.",
          "durationMinutes": 8
        },
        {
          "title": "Full loop",
          "description": "Loop D X DU X DU at 85 BPM over D G A Bm.",
          "durationMinutes": 9
        }
      ],
      "instrument": "guitar",
